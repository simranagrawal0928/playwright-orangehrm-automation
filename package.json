{
  "description": "End-to-end test automation framework for the OrangeHRM demo application, built with Playwright and TypeScript.",
  "name": "playwright-orangehrm-automation",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint .",
    "report": "playwright show-report",
    "test": "playwright test",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit"
  },
  "version": "1.0.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
